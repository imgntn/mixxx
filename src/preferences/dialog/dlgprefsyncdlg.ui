     <layout class="QVBoxLayout" name="verticalLayoutLink">
      <item>
       <widget class="QLabel" name="LabelLinkDescription">
        <property name="text">
         <string>Ableton Link synchronizes tempo and beat phase with other Link-capable applications on the local network.</string>
        </property>
        <property name="wordWrap">
         <bool>true</bool>
        </property>
       </widget>
      </item>
      <item>
       <widget class="QCheckBox" name="CheckBoxEnableLink">
        <property name="toolTip">
