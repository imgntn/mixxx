        </property>
        <property name="text">
         <string>Enable Ableton Link</string>
        </property>
       </widget>
      </item>
      <item>
       <widget class="QCheckBox" name="CheckBoxStartStopSync">
        <property name="toolTip">
         <string>Follow Link transport start and stop messages. Leave this off for most DJ sets unless transport should be shared with other Link peers.</string>
        </property>
        <property name="text">
         <string>Enable Start/Stop Sync</string>
        </property>
       </widget>
      </item>
      <item>
       <widget class="QCheckBox" name="CheckBoxLinkAudio">
        <property name="toolTip">
         <string>Enable Ableton LinkAudio channel discovery and publish Mixxx audio channels when this build includes Ableton Link 4.0 or newer.</string>
        </property>
        <property name="text">
         <string>Enable LinkAudio</string>
        </property>
       </widget>
      </item>
      <item>
       <widget class="QCheckBox" name="CheckBoxLinkAudioReceive">
        <property name="toolTip">
         <string>Mix remote LinkAudio channels from other Link peers into Mixxx's main output.</string>
        </property>
        <property name="text">
         <string>Receive LinkAudio into main output</string>
        </property>
       </widget>
      </item>
      <item>
       <widget class="QCheckBox" name="CheckBoxLinkAudioReceiveMute">
        <property name="toolTip">
         <string>Keep remote LinkAudio subscriptions active but silence them in Mixxx's main output.</string>
        </property>
        <property name="text">
         <string>Mute received LinkAudio</string>
        </property>
       </widget>
      </item>
